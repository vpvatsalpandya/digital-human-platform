{
  "name": "vesalia-digital-human",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Human Learning Platform — mobile-first medical education SaaS",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "licenses": "tsx scripts/licenses.ts",
    "manifest:validate": "tsx scripts/validate-manifests.ts",
    "assets:build:v2": "tsx scripts/assets/build-detail.ts",
    "assets:build:schematic": "tsx scripts/assets/build-schematic.ts",
    "assets:build": "tsx scripts/assets/build.ts --source hra --in ../sources/hra --bp3d ../sources/bp3d --pack hra-v1 --licence CC-BY-SA-4.0",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "ioredis": "^6.0.0",
    "next": "^15.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.15",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@netlify/plugin-nextjs": "^5.16.0",
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.0",
    "meshoptimizer": "^1.2.0",
    "postcss": "^8.4.47",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
