# Database (PostgreSQL 16 with pgvector + btree_gist)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vesalia"
# Redis (tenant cache, rate limits, exam sessions, BullMQ)
REDIS_URL="redis://localhost:6379"
# Auth
AUTH_SECRET="change-me"
# AI tutor (server-only). Without it the tutor runs retrieval-only and returns extracts.
ANTHROPIC_API_KEY=""
TUTOR_MODEL="claude-opus-5"
# Asset CDN base (immutable hashed paths). Empty = local /public/assets
NEXT_PUBLIC_ASSET_BASE=""
# Default tenant when the host does not resolve (development)
DEFAULT_TENANT_SLUG="demo"
